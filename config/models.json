{
  "selection_metric": "mean_validation_log_loss",
  "selection_direction": "minimize",
  "numeric_imputation": "median",
  "numeric_missing_indicators": true,
  "numeric_scaling": "StandardScaler",
  "categorical_imputation": "most_frequent",
  "logistic": {
    "C_values": [0.001, 0.01, 0.1, 1.0, 10.0, 100.0],
    "loan_amount_processing": ["original", "log1p"],
    "solver": "lbfgs",
    "max_iter": 2000,
    "random_state": 42
  },
  "random_forest": {
    "n_estimators": 250,
    "min_samples_leaf_values": [5, 20, 50],
    "max_features": 0.8,
    "random_state": 42,
    "n_jobs": 2
  },
  "hist_gradient_boosting": {
    "max_iter": 200,
    "learning_rate": 0.05,
    "max_leaf_nodes_values": [7, 15, 31],
    "min_samples_leaf": 30,
    "l2_regularization": 1.0,
    "early_stopping": false,
    "random_state": 42
  }
}
